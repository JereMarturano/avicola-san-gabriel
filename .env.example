# Configuracion opcional para conectar con Turso Cloud en desarrollo o produccion
# Si se dejan sin definir, el sistema utilizara automaticamente SQLite local (avicola.db)
TURSO_DATABASE_URL=libsql://avicola-db-ohio-jeremarturano.aws-us-east-2.turso.io
TURSO_AUTH_TOKEN=tu_token_aqui

# Clave secreta de Flask (en Render se autogenera mediante SECRET_KEY)
SECRET_KEY=clave_secreta_local_para_desarrollo

# Contrasena del usuario 'admin' inicial (solo se usa si la base no tiene un 'admin'; minimo 6 caracteres)
ADMIN_PASSWORD=
